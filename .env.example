OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash-lite"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
SPOTIFY_REDIRECT_URI=""
SPOTIFY_DEFAULT_MARKET="ID"

SUPABASE_URL=""
SUPABASE_API_KEY=""
SUPABASE_PROMPT_TABLE="prompt_logs"

# Required in production. Use a long random string (>=32 chars).
SESSION_SECRET=""
# Salt for hashing client IPs before persisting analytics.
IP_HASH_SALT=""

# Rate limits (slowapi syntax). Examples: "10/minute", "100/hour".
RATE_LIMIT_RECOMMEND="10/minute"
RATE_LIMIT_SUGGESTIONS="30/minute"

# Public base URL of this app (used for OpenRouter HTTP-Referer).
APP_PUBLIC_URL="http://localhost:8000"
# Cookie security: set to true behind HTTPS in production.
COOKIE_SECURE="false"

# Agentic orchestration loop (opt-in, costs extra LLM calls).
AGENT_LOOP_ENABLED="false"
AGENT_LOOP_MAX_ITERATIONS="3"
AGENT_LOOP_TIMEOUT_S="30.0"

# Optional Genius API metadata lookup for lyric-derived signals.
# The official Genius API does not return full lyrics text; this enables
# bounded metadata/lyrics-state enrichment for top candidates only.
GENIUS_ACCESS_TOKEN=""
GENIUS_LYRICS_ENABLED="false"
GENIUS_LYRICS_TOP_N="10"
GENIUS_LYRICS_CACHE_TTL_S="86400"

# Eval harness pass threshold.
EVAL_PASS_THRESHOLD="0.7"
